# Laya HTTP service URL. The official server exposes /health and /v1/systemone.
LAYA_API_URL=http://127.0.0.1:8000

# Optional bearer token when LAYA_API_KEY is set on laya-serve.
# LAYA_API_KEY=

# Pin a checkpoint: english, multilingual, or typed-decisions.
# Leave unset to let laya-serve route by language/script.
# LAYA_MODEL=

# Default answer_confidence gate for judge and route_step (0..1).
# Individual tool calls may override this value.
# LAYA_CONFIDENCE_THRESHOLD=0.8

# Optional post-hoc temperature calibration file generated by `npm run calibrate`.
# When unset or stale, judge and route_step use neutral T=1 and report that status.
# LAYA_CALIBRATION_FILE=

# Set to 1 to start laya-serve automatically from this Node process.
# Requires `pip install "laya[serve]"` or an equivalent Python environment.
# LAYA_AUTOSTART=0

# Optional child-process settings used only with LAYA_AUTOSTART=1.
# LAYA_PYTHON=python3
# LAYA_SERVE_COMMAND=laya-serve
# LAYA_SERVE_MODULE=
# LAYA_SERVE_ARGS=[]
# LAYA_DEVICE=cpu
# LAYA_PRELOAD=0

# Timeouts in milliseconds.
# LAYA_REQUEST_TIMEOUT_MS=300000
# LAYA_STARTUP_TIMEOUT_MS=120000
